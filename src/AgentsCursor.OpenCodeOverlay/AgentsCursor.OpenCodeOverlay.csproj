<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>OpenCodeCursorOverlay</AssemblyName>
  </PropertyGroup>
  <!-- Generated build and runtime outputs live below this project but are never source inputs. -->
  <ItemGroup>
    <Compile Remove="obj/**" />
    <Compile Remove="obj\**\*.cs" />
    <Compile Remove="runtime/**" />
    <Compile Remove="runtime\**\*.cs" />
    <EmbeddedResource Remove="obj/**" />
    <EmbeddedResource Remove="runtime/**" />
    <None Remove="obj/**" />
    <None Remove="runtime/**" />
  </ItemGroup>
  <!-- The "?" badge and focus suppression share the tray app's Core source (compiled in, not a DLL reference), so the
       helper stays a single self-contained build. integrations/opencode/host.ts hashes every linked
       file into the build's content address, so editing one of these rebuilds the helper. -->
  <ItemGroup>
    <Compile Include="../AgentsCursor.Core/AttentionBadge.cs" Link="Core/AttentionBadge.cs" />
    <Compile Include="../AgentsCursor.Core/CursorSettings.cs" Link="Core/CursorSettings.cs" />
    <Compile Include="../AgentsCursor.Core/ForegroundWatcher.cs" Link="Core/ForegroundWatcher.cs" />
    <Compile Include="../AgentsCursor.Core/ProgramSuppression.cs" Link="Core/ProgramSuppression.cs" />
    <Compile Include="../AgentsCursor.Core/SettingsStore.cs" Link="Core/SettingsStore.cs" />
    <Compile Include="../AgentsCursor.Core/WindowPrograms.cs" Link="Core/WindowPrograms.cs" />
  </ItemGroup>
</Project>
