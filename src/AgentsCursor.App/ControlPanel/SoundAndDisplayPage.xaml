<Page
    x:Class="AgentsCursor.App.ControlPanel.SoundAndDisplayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AgentsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Sound and Display"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <ResourceDictionary Source="/AgentsCursor;component/ControlPanel/PanelStyles.xaml" />
    </Page.Resources>

    <StackPanel Margin="40,28,40,40">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Sound and Display" />

        <!--  The live preview first, as in Windows' own personalisation pages, so every change below
              shows at once. Half dark, half light, with the pointer gliding across the seam: one
              glance shows where the token goes and how it reads on both. Its height is fixed, so a
              size change never moves the controls under the pointer; at the biggest sizes the token
              keeps inside it the way it keeps on screen.  -->
        <Border
            Margin="0,16,0,4"
            Padding="16"
            Style="{StaticResource Surface}">
            <Grid Height="260" AutomationProperties.Name="Preview: the token following a pointer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#202020" CornerRadius="6,0,0,6" />
                <Border
                    Grid.Column="1"
                    Background="#F3F3F3"
                    CornerRadius="0,6,6,0" />
                <Border
                    Grid.ColumnSpan="2"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6" />
                <local:TokenPreview
                    x:Name="Preview"
                    Grid.ColumnSpan="2"
                    Blocked="True"
                    ClipToBounds="True"
                    Roam="True" />
            </Grid>
        </Border>

        <ui:CardControl Margin="0,28,0,4" Icon="{ui:SymbolIcon Power24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Show the token" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="EnabledSwitch" AutomationProperties.Name="Show the token" />
        </ui:CardControl>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Display" />
        <ui:CardControl Icon="{ui:SymbolIcon ResizeLarge24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Size" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <!--  The size in px; double-click it to type an exact size (Enter or leaving applies,
                      Esc cancels).  -->
                <Grid
                    Width="72"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        x:Name="SizeText"
                        VerticalAlignment="Center"
                        Background="Transparent"
                        MouseLeftButtonDown="OnSizeTextClick"
                        Style="{StaticResource Secondary}"
                        TextAlignment="Right"
                        ToolTip="Double-click to type a size" />
                    <ui:TextBox
                        x:Name="SizeEdit"
                        Width="72"
                        AutomationProperties.Name="Token size in pixels"
                        ClearButtonEnabled="False"
                        KeyDown="OnSizeEditKey"
                        LostKeyboardFocus="OnSizeEditLostFocus"
                        TextAlignment="Right"
                        Visibility="Collapsed" />
                </Grid>
                <Slider
                    x:Name="SizeSlider"
                    Width="220"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Token size"
                    IsSnapToTickEnabled="True"
                    LargeChange="24"
                    SmallChange="8"
                    TickFrequency="8" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon CursorHover24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Position" />
            </ui:CardControl.Header>
            <ComboBox
                x:Name="PositionBox"
                MinWidth="220"
                AutomationProperties.Name="Position">
                <ComboBoxItem Content="Below the pointer" />
                <ComboBoxItem Content="Above the pointer" />
                <ComboBoxItem Content="Beside the pointer" />
                <ComboBoxItem
                    Padding="0"
                    Focusable="False"
                    IsEnabled="False"
                    IsHitTestVisible="False">
                    <Separator Width="180" Margin="0,2,0,2" />
                </ComboBoxItem>
                <ComboBoxItem Content="Top left corner" />
                <ComboBoxItem Content="Top right corner" />
                <ComboBoxItem Content="Bottom left corner" />
                <ComboBoxItem Content="Bottom right corner" />
            </ComboBox>
        </ui:CardControl>
        <!--  With Windows' animation effects off every style moves as Still: the box then shows Still,
              disabled, and its tooltip says why.  -->
        <ui:CardControl Icon="{ui:SymbolIcon ArrowBounce24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Motion" />
            </ui:CardControl.Header>
            <ComboBox
                x:Name="MotionBox"
                MinWidth="220"
                AutomationProperties.Name="Motion"
                ToolTipService.ShowOnDisabled="True">
                <ComboBoxItem Content="Bouncy" />
                <ComboBoxItem Content="Calm" />
                <ComboBoxItem Content="Still" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Folder24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Show project name" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="ProjectNameSwitch" AutomationProperties.Name="Show project name" />
        </ui:CardControl>
        <ui:Button
            x:Name="ResetButton"
            Margin="0,12,0,0"
            Content="Reset display"
            Icon="{ui:SymbolIcon ArrowReset24}" />

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Sound" />
        <ui:CardControl Icon="{ui:SymbolIcon Alert24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Play sounds" />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="SoundsSwitch" AutomationProperties.Name="Play sounds" />
        </ui:CardControl>
        <!--  The sound settings show while sounds are on. Each chime has a play button to hear it.  -->
        <StackPanel x:Name="SoundSettings">
            <ui:CardControl Icon="{ui:SymbolIcon QuestionCircle24}">
                <ui:CardControl.Header>
                    <local:SettingHeader Title="Needs you" />
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="PlayNeedsYou"
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="0"
                        Appearance="Transparent"
                        AutomationProperties.Name="Play the Needs you sound"
                        BorderThickness="0"
                        Icon="{ui:SymbolIcon Play24}"
                        ToolTip="Play" />
                    <ComboBox
                        x:Name="NeedsYouBox"
                        MinWidth="220"
                        AutomationProperties.Name="Needs you sound" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon CheckmarkCircle24}">
                <ui:CardControl.Header>
                    <local:SettingHeader Title="Done" />
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button
                        x:Name="PlayDone"
                        Width="36"
                        Height="36"
                        Margin="0,0,8,0"
                        Padding="0"
                        Appearance="Transparent"
                        AutomationProperties.Name="Play the Done sound"
                        BorderThickness="0"
                        Icon="{ui:SymbolIcon Play24}"
                        ToolTip="Play" />
                    <ComboBox
                        x:Name="DoneBox"
                        MinWidth="220"
                        AutomationProperties.Name="Done sound" />
                </StackPanel>
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Speaker224}">
                <ui:CardControl.Header>
                    <local:SettingHeader Title="Volume" />
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBlock
                        x:Name="VolumeText"
                        Width="72"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Style="{StaticResource Secondary}"
                        TextAlignment="Right" />
                    <Slider
                        x:Name="VolumeSlider"
                        Width="220"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Volume"
                        IsSnapToTickEnabled="True"
                        LargeChange="10"
                        Maximum="100"
                        Minimum="0"
                        SmallChange="5"
                        TickFrequency="5" />
                </StackPanel>
            </ui:CardControl>
        </StackPanel>
    </StackPanel>
</Page>
