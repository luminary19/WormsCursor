<ui:FluentWindow
    x:Class="AgentsCursor.App.ControlPanel.ControlPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AgentsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="AgentsCursor"
    Width="1040"
    Height="720"
    MinWidth="760"
    MinHeight="540"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  The title bar sits in its own row above the sidebar, so it isn't handed to the
              NavigationView (which would indent it for a back button this window doesn't have and push
              the page down under an empty band).  -->
        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="280"
            PaneDisplayMode="Left"
            Transition="FadeInWithSlide">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    x:Name="TokenItem"
                    Content="Token"
                    Icon="{ui:SymbolIcon CursorHover24}"
                    TargetPageType="{x:Type local:TokenPage}" />
                <ui:NavigationViewItem
                    Content="Icons"
                    Icon="{ui:SymbolIcon Emoji24}"
                    TargetPageType="{x:Type local:IconsPage}" />
                <ui:NavigationViewItem
                    Content="Agents"
                    Icon="{ui:SymbolIcon Bot24}"
                    TargetPageType="{x:Type local:AgentsPage}" />
                <ui:NavigationViewItem
                    Content="Apps"
                    Icon="{ui:SymbolIcon EyeOff24}"
                    TargetPageType="{x:Type local:AppsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="About"
                    Icon="{ui:SymbolIcon Info24}"
                    TargetPageType="{x:Type local:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!--  The app icon and name line up with the sidebar below them: the icon over the items' icons,
              the name over their labels (padding 17 + 16 px icon + 12 = the labels' 45 px).  -->
        <ui:TitleBar
            x:Name="TitleBar"
            Title="AgentsCursor"
            Grid.Row="0"
            Padding="17,4,12,4"
            ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleIcon" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
