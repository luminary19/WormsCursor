<Page
    x:Class="AgentsCursor.App.ControlPanel.AboutPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AgentsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="About"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <ResourceDictionary Source="/AgentsCursor;component/ControlPanel/PanelStyles.xaml" />
    </Page.Resources>

    <StackPanel Margin="40,28,40,40">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="About" />

        <!--  Who and which version.  -->
        <Border
            Margin="0,16,0,4"
            Padding="20,18,20,18"
            Style="{StaticResource Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="64"
                    Height="64"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                    <Image
                        x:Name="AppIcon"
                        Width="38"
                        Height="38"
                        RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <StackPanel
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center">
                    <ui:TextBlock
                        FontFamily="{StaticResource PanelDisplayFont}"
                        FontTypography="Subtitle"
                        Text="AgentsCursor" />
                    <ui:TextBlock
                        Margin="0,2,0,0"
                        Style="{StaticResource Secondary}"
                        Text="Shows you when an AI agent is waiting for you." />
                </StackPanel>
                <ui:TextBlock
                    x:Name="VersionText"
                    Grid.Column="2"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Secondary}" />
            </Grid>
        </Border>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Updates" />
        <ui:CardControl Icon="{ui:SymbolIcon ArrowSync24}">
            <ui:CardControl.Header>
                <local:SettingHeader x:Name="UpdateHeader" Title="Check for updates" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:ProgressRing
                    x:Name="UpdateRing"
                    Width="20"
                    Height="20"
                    Margin="0,0,12,0"
                    IsIndeterminate="True"
                    Visibility="Collapsed" />
                <ui:Button x:Name="UpdateButton" MinWidth="120" />
            </StackPanel>
        </ui:CardControl>

        <ui:CardExpander
            x:Name="WhatsNew"
            Margin="0,0,0,4"
            ContentPadding="20,8,20,20"
            Icon="{ui:SymbolIcon Sparkle24}">
            <ui:CardExpander.Header>
                <local:SettingHeader Title="What's new" Description="Release notes for every version." />
            </ui:CardExpander.Header>
            <StackPanel>
                <StackPanel
                    x:Name="NotesLoading"
                    Margin="0,8,0,0"
                    Orientation="Horizontal">
                    <ui:ProgressRing
                        Width="16"
                        Height="16"
                        Margin="0,0,10,0"
                        IsIndeterminate="True" />
                    <ui:TextBlock Style="{StaticResource Secondary}" Text="Loading release notes..." />
                </StackPanel>
                <ui:InfoBar
                    x:Name="NotesError"
                    Title="Couldn't load the release notes"
                    IsClosable="False"
                    Severity="Warning" />
                <StackPanel x:Name="NotesPanel" />
                <ui:Button
                    x:Name="ReleasesButton"
                    Margin="0,16,0,0"
                    Content="See all releases on GitHub"
                    Icon="{ui:SymbolIcon Open24}" />
            </StackPanel>
        </ui:CardExpander>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Appearance" />
        <ui:CardControl Icon="{ui:SymbolIcon DarkTheme24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Theme" Description="Light or dark for this window. System follows your Windows setting." />
            </ui:CardControl.Header>
            <!--  In ThemePreference order.  -->
            <ComboBox
                x:Name="ThemeBox"
                MinWidth="200"
                AutomationProperties.Name="Theme">
                <ComboBoxItem Content="System" />
                <ComboBoxItem Content="Light" />
                <ComboBoxItem Content="Dark" />
            </ComboBox>
        </ui:CardControl>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Startup" />
        <ui:InfoBar
            x:Name="AutostartError"
            Title="Couldn't change startup"
            Margin="0,0,0,8"
            IsClosable="True"
            Severity="Error" />
        <ui:CardControl Icon="{ui:SymbolIcon Rocket24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Start with Windows" Description="Open AgentsCursor in the tray when you sign in." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="AutostartSwitch" AutomationProperties.Name="Start with Windows" />
        </ui:CardControl>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Related links" />
        <ui:CardAction x:Name="RepoLink" Icon="{ui:SymbolIcon Code24}">
            <local:SettingHeader x:Name="RepoHeader" Title="Source code" />
        </ui:CardAction>
        <ui:CardAction x:Name="ReleasesLink" Icon="{ui:SymbolIcon History24}">
            <local:SettingHeader Title="Releases" Description="Every version, with downloads and notes." />
        </ui:CardAction>
    </StackPanel>
</Page>
