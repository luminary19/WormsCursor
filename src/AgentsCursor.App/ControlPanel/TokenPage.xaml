<Page
    x:Class="AgentsCursor.App.ControlPanel.TokenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AgentsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Token"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <ResourceDictionary Source="/AgentsCursor;component/ControlPanel/PanelStyles.xaml" />
    </Page.Resources>

    <StackPanel Margin="40,28,40,40">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Token" />

        <!--  The live preview first, as in Windows' own personalisation pages, so every change below
              shows at once. Half dark, half light, with the pointer gliding across the seam: one
              glance shows where the token goes and how it reads on both. Its height is fixed, so a
              size change never moves the controls under the pointer; at the biggest sizes the token
              keeps inside it the way it keeps on screen.  -->
        <Border
            Margin="0,16,0,4"
            Padding="16"
            Style="{StaticResource Surface}">
            <Grid Height="260" AutomationProperties.Name="Preview: the token following a pointer">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Background="#202020" CornerRadius="6,0,0,6" />
                <Border
                    Grid.Column="1"
                    Background="#F3F3F3"
                    CornerRadius="0,6,6,0" />
                <Border
                    Grid.ColumnSpan="2"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6" />
                <local:TokenPreview
                    x:Name="Preview"
                    Grid.ColumnSpan="2"
                    Blocked="True"
                    ClipToBounds="True"
                    Roam="True" />
            </Grid>
        </Border>

        <ui:CardControl Margin="0,28,0,4" Icon="{ui:SymbolIcon Power24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Show the token" Description="When it's off, agents are still tracked but nothing appears." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="EnabledSwitch" AutomationProperties.Name="Show the token" />
        </ui:CardControl>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Size and position" />
        <ui:CardControl Icon="{ui:SymbolIcon ResizeLarge24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Size" />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:TextBlock
                    x:Name="SizeText"
                    MinWidth="52"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Secondary}"
                    TextAlignment="Right" />
                <Slider
                    x:Name="SizeSlider"
                    Width="220"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Token size"
                    IsSnapToTickEnabled="True"
                    LargeChange="24"
                    SmallChange="8"
                    TickFrequency="8" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon CursorHover24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Position" />
            </ui:CardControl.Header>
            <ComboBox
                x:Name="PositionBox"
                MinWidth="220"
                AutomationProperties.Name="Position">
                <ComboBoxItem Content="Below the pointer" />
                <ComboBoxItem Content="Above the pointer" />
                <ComboBoxItem Content="Beside the pointer" />
                <ComboBoxItem
                    Padding="0"
                    Focusable="False"
                    IsEnabled="False"
                    IsHitTestVisible="False">
                    <Separator Width="180" Margin="0,2,0,2" />
                </ComboBoxItem>
                <ComboBoxItem Content="Top left corner" />
                <ComboBoxItem Content="Top right corner" />
                <ComboBoxItem Content="Bottom left corner" />
                <ComboBoxItem Content="Bottom right corner" />
            </ComboBox>
        </ui:CardControl>
        <ui:Button
            x:Name="ResetButton"
            Margin="0,12,0,0"
            Content="Reset size and position"
            Icon="{ui:SymbolIcon ArrowReset24}" />
    </StackPanel>
</Page>
