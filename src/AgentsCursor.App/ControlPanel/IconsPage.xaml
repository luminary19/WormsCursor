<Page
    x:Class="AgentsCursor.App.ControlPanel.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AgentsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Icons">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentsCursor;component/ControlPanel/PanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhen" />

            <!--  One agent to edit: its current icon and its name, stretched to its grid cell.  -->
            <DataTemplate x:Key="AgentTileTemplate" DataType="{x:Type local:AgentTile}">
                <RadioButton
                    Height="64"
                    Margin="0,0,8,8"
                    Padding="12,0,8,0"
                    HorizontalAlignment="Stretch"
                    Tag="NoCheck"
                    AutomationProperties.Name="{Binding Name}"
                    Checked="OnAgentChecked"
                    GroupName="Agents"
                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                    IsTabStop="{Binding IsSelected, Mode=OneWay}"
                    Style="{StaticResource ChoiceTile}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image
                            Width="32"
                            Height="32"
                            Source="{Binding Image}" />
                        <ui:TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontTypography="Body"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </RadioButton>
            </DataTemplate>

            <!--  One icon to choose: the picture at token size, its name. An added one can be removed
                  with the "x" that shows while the pointer or the keyboard focus is on its tile.  -->
            <DataTemplate x:Key="IconTileTemplate" DataType="{x:Type local:IconTile}">
                <Grid x:Name="Tile" Margin="0,0,8,8">
                    <RadioButton
                        Width="96"
                        Height="104"
                        AutomationProperties.Name="{Binding AutomationName}"
                        Checked="OnIconChecked"
                        GroupName="Icons"
                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                        IsTabStop="{Binding IsSelected, Mode=OneWay}"
                        Style="{StaticResource ChoiceTile}"
                        ToolTip="{Binding Name}">
                        <StackPanel VerticalAlignment="Center">
                            <Image
                                Width="48"
                                Height="48"
                                Source="{Binding Image}" />
                            <ui:TextBlock
                                Margin="6,10,6,0"
                                FontTypography="Caption"
                                Text="{Binding Name}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>
                    <Grid
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Visibility="{Binding IsCustom, Converter={StaticResource VisibleWhen}}">
                        <ui:Button
                            x:Name="RemoveButton"
                            Width="24"
                            Height="24"
                            Margin="4,4,0,0"
                            Padding="0"
                            Appearance="Secondary"
                            AutomationProperties.Name="{Binding RemoveName}"
                            Click="OnRemoveIcon"
                            Icon="{ui:SymbolIcon Dismiss12}"
                            ToolTip="Remove icon"
                            Visibility="Hidden" />
                    </Grid>
                </Grid>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Tile" Property="IsMouseOver" Value="True">
                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <Trigger SourceName="Tile" Property="IsKeyboardFocusWithin" Value="True">
                        <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="Wrap">
                <WrapPanel />
            </ItemsPanelTemplate>
            <ItemsPanelTemplate x:Key="AgentGrid">
                <UniformGrid Columns="4" />
            </ItemsPanelTemplate>

            <!--  A swatch half: one whole token on one backdrop.  -->
            <Style x:Key="SwatchHalf" TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="40,28,40,40">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Icons" />
        <ui:TextBlock Style="{StaticResource PageLead}" Text="Choose how each agent looks on the token: its own logo, one of its mascots, or a picture of your own." />

        <!--  What the chosen icon looks like in both states, each over dark and over light, at its
              real size: side by side, or one above the other when the page is too narrow for four
              whole tokens in a row.  -->
        <Border
            Margin="0,16,0,4"
            Padding="16,16,0,0"
            Style="{StaticResource Surface}">
            <UniformGrid
                x:Name="Swatches"
                Columns="2"
                SizeChanged="OnSwatchesSize">
              <StackPanel Margin="0,0,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Background="#202020"
                        CornerRadius="6,0,0,6"
                        Style="{StaticResource SwatchHalf}">
                        <local:TokenPreview x:Name="DoneOnDark" />
                    </Border>
                    <Border
                        Grid.Column="1"
                        Background="#F3F3F3"
                        BorderThickness="0,1,1,1"
                        CornerRadius="0,6,6,0"
                        Style="{StaticResource SwatchHalf}">
                        <local:TokenPreview x:Name="DoneOnLight" />
                    </Border>
                </Grid>
                <StackPanel Margin="2,12,0,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Done" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Style="{StaticResource Secondary}"
                        Text="The agent finished its turn." />
                </StackPanel>
              </StackPanel>
              <StackPanel Margin="0,0,16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Background="#202020"
                        CornerRadius="6,0,0,6"
                        Style="{StaticResource SwatchHalf}">
                        <local:TokenPreview
                            x:Name="BlockedOnDark"
                            Blocked="True"
                            Others="1" />
                    </Border>
                    <Border
                        Grid.Column="1"
                        Background="#F3F3F3"
                        BorderThickness="0,1,1,1"
                        CornerRadius="0,6,6,0"
                        Style="{StaticResource SwatchHalf}">
                        <local:TokenPreview
                            x:Name="BlockedOnLight"
                            Blocked="True"
                            Others="1" />
                    </Border>
                </Grid>
                <StackPanel Margin="2,12,0,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Needs you" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Style="{StaticResource Secondary}"
                        Text="Waiting for your answer. The +1 means another agent is waiting too." />
                </StackPanel>
              </StackPanel>
            </UniformGrid>
        </Border>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Agents" />
        <!--  The cells carry an 8 px gap on their right; the list gives it back so the row ends
              flush with the surfaces below.  -->
        <ItemsControl
            x:Name="AgentList"
            Margin="0,0,-8,0"
            AutomationProperties.Name="Agents"
            Focusable="False"
            ItemTemplate="{StaticResource AgentTileTemplate}"
            ItemsPanel="{StaticResource AgentGrid}"
            PreviewKeyDown="OnTileKey"
            SizeChanged="OnAgentListSize" />

        <ui:TextBlock
            x:Name="GalleryHeader"
            Style="{StaticResource SectionHeader}"
            Text="Choose an icon" />
        <Border Padding="16,16,8,8" Style="{StaticResource Surface}">
            <StackPanel>
                <ItemsControl
                    x:Name="BuiltInList"
                    Focusable="False"
                    ItemTemplate="{StaticResource IconTileTemplate}"
                    ItemsPanel="{StaticResource Wrap}"
                    PreviewKeyDown="OnTileKey" />

                <ui:TextBlock
                    Margin="0,8,0,8"
                    FontTypography="BodyStrong"
                    Text="Your icons" />
                <WrapPanel>
                    <ItemsControl
                        x:Name="CustomList"
                        Focusable="False"
                        ItemTemplate="{StaticResource IconTileTemplate}"
                        ItemsPanel="{StaticResource Wrap}"
                        PreviewKeyDown="OnTileKey" />
                    <Button
                        x:Name="AddButton"
                        Width="96"
                        Height="104"
                        Margin="0,0,8,8"
                        AutomationProperties.HelpText="Choose an SVG file to use as this agent's icon"
                        AutomationProperties.Name="Add an SVG icon"
                        Click="OnAdd"
                        Style="{StaticResource AddTile}"
                        ToolTipService.ShowOnDisabled="True">
                        <Grid VerticalAlignment="Center">
                            <StackPanel x:Name="AddLabel">
                                <ui:SymbolIcon FontSize="24" Symbol="Add24" />
                                <ui:TextBlock
                                    Margin="0,10,0,0"
                                    FontTypography="Caption"
                                    Text="Add SVG…"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="AddBusy" Visibility="Collapsed">
                                <ui:ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsIndeterminate="True" />
                                <ui:TextBlock
                                    Margin="0,10,0,0"
                                    FontTypography="Caption"
                                    Text="Checking…"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </WrapPanel>

                <!--  Right under the tiles it is about: what went wrong with an added file, or the
                      icon just removed (with Undo); otherwise the hints for adding one.  -->
                <Grid Margin="0,4,8,8">
                    <ui:InfoBar x:Name="StatusBar" IsClosable="True" />
                    <ui:Button
                        x:Name="UndoButton"
                        Margin="0,0,52,0"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="OnUndoRemove"
                        Content="Undo"
                        Visibility="Collapsed" />
                </Grid>
                <ui:TextBlock
                    x:Name="AddHint"
                    Margin="0,4,8,8"
                    FontTypography="Caption"
                    Style="{StaticResource Secondary}" />
            </StackPanel>
        </Border>

        <ui:Button
            x:Name="ResetButton"
            Margin="0,12,0,0"
            Click="OnReset"
            Content="Reset all icons to the originals"
            Icon="{ui:SymbolIcon ArrowReset24}" />
    </StackPanel>
</Page>
