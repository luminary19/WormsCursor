<Page
    x:Class="AgentsCursor.App.ControlPanel.IconsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AgentsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Icons">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentsCursor;component/ControlPanel/PanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="VisibleWhen" />

            <!--  One agent to edit: its current icon and its name.  -->
            <DataTemplate x:Key="AgentTileTemplate" DataType="{x:Type local:AgentTile}">
                <RadioButton
                    Width="152"
                    Height="64"
                    Margin="0,0,8,8"
                    Padding="12,0,8,0"
                    Tag="NoCheck"
                    AutomationProperties.Name="{Binding Name}"
                    Checked="OnAgentChecked"
                    GroupName="Agents"
                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                    IsTabStop="{Binding IsSelected, Mode=OneWay}"
                    Style="{StaticResource ChoiceTile}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Image
                            Width="32"
                            Height="32"
                            Source="{Binding Image}" />
                        <ui:TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontTypography="Body"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </RadioButton>
            </DataTemplate>

            <!--  One icon to choose: the picture at token size, its name; an added one can be removed.  -->
            <DataTemplate x:Key="IconTileTemplate" DataType="{x:Type local:IconTile}">
                <Grid Margin="0,0,8,8">
                    <RadioButton
                        Width="96"
                        Height="104"
                        AutomationProperties.Name="{Binding AutomationName}"
                        Checked="OnIconChecked"
                        GroupName="Icons"
                        IsChecked="{Binding IsSelected, Mode=OneWay}"
                        IsTabStop="{Binding IsSelected, Mode=OneWay}"
                        Style="{StaticResource ChoiceTile}"
                        ToolTip="{Binding Name}">
                        <StackPanel VerticalAlignment="Center">
                            <Image
                                Width="48"
                                Height="48"
                                Source="{Binding Image}" />
                            <ui:TextBlock
                                Margin="6,10,6,0"
                                FontTypography="Caption"
                                Text="{Binding Name}"
                                TextAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </RadioButton>
                    <ui:Button
                        Width="24"
                        Height="24"
                        Margin="4,4,0,0"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        Appearance="Transparent"
                        AutomationProperties.Name="{Binding RemoveName}"
                        Click="OnRemoveIcon"
                        Icon="{ui:SymbolIcon Dismiss12}"
                        ToolTip="Remove icon"
                        Visibility="{Binding IsCustom, Converter={StaticResource VisibleWhen}}" />
                </Grid>
            </DataTemplate>

            <ItemsPanelTemplate x:Key="Wrap">
                <WrapPanel />
            </ItemsPanelTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="40,28,40,40">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Icons" />
        <ui:TextBlock Style="{StaticResource PageLead}" Text="Choose how each agent looks on the token: its own logo, one of its mascots, or a picture of your own." />

        <!--  What the chosen icon looks like in both states, over dark and light.  -->
        <Border
            Margin="0,16,0,4"
            Padding="16,16,16,12"
            Style="{StaticResource Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="DoneSwatch" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#202020" CornerRadius="6,0,0,6" />
                    <Border
                        Grid.Column="1"
                        Background="#F3F3F3"
                        CornerRadius="0,6,6,0" />
                    <Border
                        Grid.ColumnSpan="2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6" />
                    <local:TokenPreview x:Name="DonePreview" Grid.ColumnSpan="2" />
                </Grid>
                <Grid x:Name="BlockedSwatch" Grid.Column="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#202020" CornerRadius="6,0,0,6" />
                    <Border
                        Grid.Column="1"
                        Background="#F3F3F3"
                        CornerRadius="0,6,6,0" />
                    <Border
                        Grid.ColumnSpan="2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6" />
                    <local:TokenPreview
                        x:Name="BlockedPreview"
                        Grid.ColumnSpan="2"
                        Blocked="True"
                        Others="1" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="2,12,0,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Done" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Style="{StaticResource Secondary}"
                        Text="The agent finished its turn." />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="2,12,0,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Needs you" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Style="{StaticResource Secondary}"
                        Text="The agent is waiting for your answer. +1: another agent is waiting too." />
                </StackPanel>
            </Grid>
        </Border>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Agent" />
        <ItemsControl
            x:Name="AgentList"
            AutomationProperties.Name="Agent"
            Focusable="False"
            ItemTemplate="{StaticResource AgentTileTemplate}"
            ItemsPanel="{StaticResource Wrap}"
            PreviewKeyDown="OnTileKey" />

        <ui:TextBlock
            x:Name="GalleryHeader"
            Style="{StaticResource SectionHeader}"
            Text="Choose an icon" />
        <ui:InfoBar
            x:Name="UploadError"
            Margin="0,0,0,8"
            IsClosable="True"
            Severity="Error"
            Title="That file couldn't be used" />
        <Border Padding="16,16,8,8" Style="{StaticResource Surface}">
            <StackPanel>
                <ItemsControl
                    x:Name="BuiltInList"
                    Focusable="False"
                    ItemTemplate="{StaticResource IconTileTemplate}"
                    ItemsPanel="{StaticResource Wrap}"
                    PreviewKeyDown="OnTileKey" />

                <ui:TextBlock
                    Margin="0,8,0,8"
                    FontTypography="BodyStrong"
                    Text="Your icons" />
                <WrapPanel>
                    <ItemsControl
                        x:Name="CustomList"
                        Focusable="False"
                        ItemTemplate="{StaticResource IconTileTemplate}"
                        ItemsPanel="{StaticResource Wrap}"
                        PreviewKeyDown="OnTileKey" />
                    <Button
                        x:Name="AddButton"
                        Width="96"
                        Height="104"
                        Margin="0,0,8,8"
                        AutomationProperties.HelpText="Choose an SVG file to use as this agent's icon"
                        AutomationProperties.Name="Add an SVG icon"
                        Click="OnAdd"
                        Style="{StaticResource AddTile}">
                        <Grid VerticalAlignment="Center">
                            <StackPanel x:Name="AddLabel">
                                <ui:SymbolIcon FontSize="24" Symbol="Add24" />
                                <ui:TextBlock
                                    Margin="0,10,0,0"
                                    FontTypography="Caption"
                                    Text="Add SVG…"
                                    TextAlignment="Center" />
                            </StackPanel>
                            <StackPanel x:Name="AddBusy" Visibility="Collapsed">
                                <ui:ProgressRing
                                    Width="24"
                                    Height="24"
                                    IsIndeterminate="True" />
                                <ui:TextBlock
                                    Margin="0,10,0,0"
                                    FontTypography="Caption"
                                    Text="Checking…"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </WrapPanel>
                <ui:TextBlock
                    Margin="0,4,8,8"
                    FontTypography="Caption"
                    Style="{StaticResource Secondary}"
                    Text="SVG files up to 256 KB. Flat shapes, gradients, groups and transforms work best. Scripts and links to other files are removed, and each agent can keep up to 24 of your own icons." />
            </StackPanel>
        </Border>

        <ui:Button
            x:Name="ResetButton"
            Margin="0,12,0,0"
            Click="OnReset"
            Content="Reset all icons to the originals"
            Icon="{ui:SymbolIcon ArrowReset24}" />
    </StackPanel>
</Page>
