<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!--  Shared look for the control panel's pages. Spacing is on a 4/8 px rhythm:
          cards in a group sit 4 apart, groups 28 apart, page edges 40 / 28.  -->

    <FontFamily x:Key="PanelDisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>

    <!--  Page title, e.g. "Token".  -->
    <Style x:Key="PageTitle" TargetType="ui:TextBlock">
        <Setter Property="FontTypography" Value="Title" />
        <Setter Property="FontFamily" Value="{StaticResource PanelDisplayFont}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--  One-line explanation under a page title.  -->
    <Style x:Key="PageLead" TargetType="ui:TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!--  Group heading above a set of cards.  -->
    <Style x:Key="SectionHeader" TargetType="ui:TextBlock">
        <Setter Property="FontTypography" Value="BodyStrong" />
        <Setter Property="Margin" Value="0,28,0,8" />
    </Style>

    <!--  Secondary text: card descriptions, footnotes.  -->
    <Style x:Key="Secondary" TargetType="ui:TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  A settings row. Cards are surfaces, not controls: only what is inside them takes focus.  -->
    <Style BasedOn="{StaticResource {x:Type ui:CardControl}}" TargetType="ui:CardControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--  A clickable settings row (opens something).  -->
    <Style BasedOn="{StaticResource {x:Type ui:CardAction}}" TargetType="ui:CardAction">
        <Setter Property="MinHeight" Value="68" />
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>

    <!--  An expandable settings row.  -->
    <Style BasedOn="{StaticResource {x:Type ui:CardExpander}}" TargetType="ui:CardExpander">
        <Setter Property="Padding" Value="16,12,16,12" />
        <Setter Property="MinHeight" Value="68" />
    </Style>

    <!--  A plain card surface for custom content (preview, lists).  -->
    <Style x:Key="Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--  Hairline between rows inside one surface.  -->
    <Style x:Key="RowDivider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
    </Style>

    <!--  The coloured dot in front of a status line.  -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="Margin" Value="0,1,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  The system focus ring around a tile. As a FocusVisualStyle, WPF shows it only when focus
          came from the keyboard, as Windows does: a click leaves no ring behind.  -->
    <Style x:Key="TileFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="-3"
                        BorderBrush="{DynamicResource FocusStrokeColorOuterBrush}"
                        BorderThickness="2"
                        CornerRadius="8" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  A gallery tile: a radio choice drawn as a card (the Icons page's agents and icons). The
          selected one is tinted with the accent and has an accent border and a check, so it stands
          out even with a grey accent colour; keyboard focus gets the system focus ring.  -->
    <Style x:Key="ChoiceTile" TargetType="RadioButton">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TileFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border
                            x:Name="Card"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Grid>
                                <Border
                                    x:Name="Tint"
                                    Background="{DynamicResource AccentFillColorDefaultBrush}"
                                    CornerRadius="5"
                                    Opacity="0.14"
                                    Visibility="Collapsed" />
                                <ContentPresenter Margin="{TemplateBinding Padding}" />
                            </Grid>
                        </Border>
                        <Border
                            x:Name="Check"
                            Width="20"
                            Height="20"
                            Margin="0,6,6,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentFillColorDefaultBrush}"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <ui:SymbolIcon
                                FontSize="12"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Symbol="Checkmark12" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Tint" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!--  Tag="NoCheck": the accent border alone marks the choice (a compact tile).  -->
                        <Trigger Property="Tag" Value="NoCheck">
                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  The "Add SVG…" tile: a dashed card that opens the file picker.  -->
    <Style x:Key="AddTile" TargetType="Button">
        <Setter Property="FocusVisualStyle" Value="{StaticResource TileFocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle
                            x:Name="Dash"
                            Fill="Transparent"
                            RadiusX="6"
                            RadiusY="6"
                            Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                            StrokeDashArray="4 3"
                            StrokeThickness="1.5" />
                        <ContentPresenter x:Name="Content" Margin="{TemplateBinding Padding}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dash" Property="Fill" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        </Trigger>
                        <!--  Off (at the limit): dimmed like any disabled control.  -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Dash" Property="Fill" Value="Transparent" />
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Setter TargetName="Content" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
