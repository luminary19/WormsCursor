<Page
    x:Class="AgentsCursor.App.ControlPanel.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:AgentsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Apps"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/AgentsCursor;component/ControlPanel/PanelStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  An app's icon, or a generic glyph while its exe isn't known.  -->
            <DataTemplate x:Key="AppIcon" DataType="{x:Type local:AppRow}">
                <Grid
                    Width="24"
                    Height="24"
                    Margin="0,0,16,0"
                    VerticalAlignment="Center">
                    <ui:SymbolIcon
                        x:Name="Glyph"
                        FontSize="20"
                        Symbol="WindowApps24"
                        Visibility="Collapsed" />
                    <Image
                        x:Name="Picture"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Icon}" />
                </Grid>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                        <Setter TargetName="Picture" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--  The app's name over its second line (hidden when there is none).  -->
            <DataTemplate x:Key="AppText" DataType="{x:Type local:AppRow}">
                <StackPanel VerticalAlignment="Center">
                    <ui:TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <ui:TextBlock
                        x:Name="Detail"
                        FontTypography="Caption"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="{Binding Detail}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Detail}" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding Detail}" Value="{x:Null}">
                        <Setter TargetName="Detail" Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Page.Resources>

    <StackPanel Margin="40,28,40,40">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Apps" />
        <ui:TextBlock Style="{StaticResource PageLead}" Text="Keep the token out of your games. While one of these apps is in front, fullscreen or windowed, the token stays hidden. Agents are still tracked, and it comes back when you switch away." />

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Hide the token while using" />

        <!--  The list, or a friendly empty state.  -->
        <Border x:Name="ListSurface" Style="{StaticResource Surface}">
            <ItemsControl
                x:Name="AppList"
                AutomationProperties.Name="Apps that hide the token"
                Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:AppRow}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="Divider"
                                Margin="16,0,16,0"
                                Style="{StaticResource RowDivider}" />
                            <Grid
                                Grid.Row="1"
                                MinHeight="48"
                                Margin="16,4,10,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource AppText}" />
                                <ui:Button
                                    Grid.Column="2"
                                    Width="36"
                                    Height="36"
                                    Margin="12,0,0,0"
                                    Padding="0"
                                    Appearance="Transparent"
                                    AutomationProperties.Name="{Binding Program, StringFormat='Remove {0}'}"
                                    BorderThickness="0"
                                    Click="OnRemove"
                                    Icon="{ui:SymbolIcon Delete24}"
                                    ToolTip="Remove" />
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Border
            x:Name="EmptyState"
            Padding="24,24,24,24"
            Style="{StaticResource Surface}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Symbol="Games24" />
                <ui:TextBlock
                    Margin="0,8,0,2"
                    HorizontalAlignment="Center"
                    FontTypography="BodyStrong"
                    Text="No apps yet" />
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource Secondary}"
                    Text="The token shows over every app. Add a game below to keep it out of the way."
                    TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!--  Adding: type a name, or pick from what's open right now.  -->
        <ui:CardExpander
            x:Name="AddExpander"
            Margin="0,0,0,4"
            ContentPadding="0"
            Icon="{ui:SymbolIcon Add24}">
            <ui:CardExpander.Header>
                <local:SettingHeader Title="Add an app" Description="Pick one that's open now, or type its file name." />
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        x:Name="NameBox"
                        AutomationProperties.Name="App file name"
                        PlaceholderText="File name, for example dota2.exe" />
                    <ui:Button
                        x:Name="AddNameButton"
                        Grid.Column="1"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Content="Add" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Margin="16,12,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="Open now" />
                    <ui:Button
                        x:Name="RefreshButton"
                        Grid.Column="1"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Content="Refresh"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </Grid>
                <ItemsControl
                    x:Name="OpenList"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="Apps open now"
                    Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:AppRow}">
                            <Grid Margin="16,6,16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource AppIcon}" />
                                <ContentPresenter
                                    Grid.Column="1"
                                    Content="{Binding}"
                                    ContentTemplate="{StaticResource AppText}" />
                                <ui:Button
                                    Grid.Column="2"
                                    MinWidth="88"
                                    Margin="16,0,0,0"
                                    AutomationProperties.Name="{Binding Program, StringFormat='Add {0}'}"
                                    Click="OnAddOpen"
                                    Content="Add" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:TextBlock
                    x:Name="NothingOpen"
                    Margin="16,4,16,16"
                    Style="{StaticResource Secondary}"
                    Text="No other apps have a window open."
                    Visibility="Collapsed" />
            </StackPanel>
        </ui:CardExpander>

        <ui:Button
            x:Name="DefaultsButton"
            Margin="0,16,0,0"
            Content="Restore the default list"
            Icon="{ui:SymbolIcon ArrowReset24}" />
    </StackPanel>
</Page>
