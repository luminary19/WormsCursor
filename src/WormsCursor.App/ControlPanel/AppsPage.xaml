<Page
    x:Class="WormsCursor.App.ControlPanel.AppsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="clr-namespace:WormsCursor.Core;assembly=WormsCursor.Core"
    xmlns:local="clr-namespace:WormsCursor.App.ControlPanel"
    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Apps">

    <Page.Resources>
        <ResourceDictionary Source="/WormsCursor;component/ControlPanel/PanelStyles.xaml" />
    </Page.Resources>

    <StackPanel Margin="40,28,40,40">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Apps" />
        <ui:TextBlock Style="{StaticResource PageLead}" Text="Keep the token out of your games. While one of these programs is in front, fullscreen or windowed, the token stays hidden. Agents are still tracked, and it comes back when you switch away." />

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Hide the token while using" />

        <!--  The list, or a friendly empty state.  -->
        <Border x:Name="ListSurface" Style="{StaticResource Surface}">
            <ItemsControl
                x:Name="ProgramList"
                AutomationProperties.Name="Programs that hide the token"
                Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border
                                x:Name="Divider"
                                Margin="16,0,16,0"
                                Style="{StaticResource RowDivider}" />
                            <Grid Grid.Row="1" Margin="16,10,16,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon
                                    Margin="0,0,16,0"
                                    VerticalAlignment="Center"
                                    FontSize="20"
                                    Symbol="WindowApps24" />
                                <ui:TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{Binding}"
                                    TextTrimming="CharacterEllipsis" />
                                <ui:Button
                                    Grid.Column="2"
                                    AutomationProperties.Name="{Binding StringFormat='Remove {0}'}"
                                    Click="OnRemove"
                                    Content="Remove"
                                    Icon="{ui:SymbolIcon Delete24}" />
                            </Grid>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
        <Border
            x:Name="EmptyState"
            Padding="24,24,24,24"
            Style="{StaticResource Surface}">
            <StackPanel HorizontalAlignment="Center">
                <ui:SymbolIcon
                    HorizontalAlignment="Center"
                    FontSize="28"
                    Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                    Symbol="Games24" />
                <ui:TextBlock
                    Margin="0,8,0,2"
                    HorizontalAlignment="Center"
                    FontTypography="BodyStrong"
                    Text="No programs yet" />
                <ui:TextBlock
                    HorizontalAlignment="Center"
                    Style="{StaticResource Secondary}"
                    Text="The token shows over every program. Add a game below to keep it out of the way."
                    TextAlignment="Center" />
            </StackPanel>
        </Border>

        <!--  Adding: type a name, or pick from what's open right now.  -->
        <ui:CardExpander
            x:Name="AddExpander"
            Margin="0,0,0,4"
            ContentPadding="0"
            Icon="{ui:SymbolIcon Add24}">
            <ui:CardExpander.Header>
                <local:SettingHeader Title="Add a program" Description="Pick one that's open now, or type its name." />
            </ui:CardExpander.Header>
            <StackPanel>
                <Grid Margin="16,14,16,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        x:Name="NameBox"
                        AutomationProperties.Name="Program name"
                        PlaceholderText="Program name, for example dota2.exe" />
                    <ui:Button
                        x:Name="AddNameButton"
                        Grid.Column="1"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        Appearance="Primary"
                        Content="Add" />
                </Grid>
                <Border Style="{StaticResource RowDivider}" />
                <Grid Margin="16,12,8,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:TextBlock
                        VerticalAlignment="Center"
                        FontTypography="BodyStrong"
                        Text="Open now" />
                    <ui:Button
                        x:Name="RefreshButton"
                        Grid.Column="1"
                        Appearance="Transparent"
                        BorderThickness="0"
                        Content="Refresh"
                        Icon="{ui:SymbolIcon ArrowClockwise24}" />
                </Grid>
                <ItemsControl
                    x:Name="OpenList"
                    Margin="0,0,0,8"
                    AutomationProperties.Name="Programs open now"
                    Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type core:WindowProgram}">
                            <Grid Margin="16,6,16,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <ui:TextBlock Text="{Binding Program}" TextTrimming="CharacterEllipsis" />
                                    <ui:TextBlock
                                        FontTypography="Caption"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Title}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Title}" />
                                </StackPanel>
                                <ui:Button
                                    Grid.Column="1"
                                    MinWidth="88"
                                    Margin="16,0,0,0"
                                    AutomationProperties.Name="{Binding Program, StringFormat='Add {0}'}"
                                    Click="OnAddOpen"
                                    Content="Add" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ui:TextBlock
                    x:Name="NothingOpen"
                    Margin="16,4,16,16"
                    Style="{StaticResource Secondary}"
                    Text="No other programs have a window open."
                    Visibility="Collapsed" />
            </StackPanel>
        </ui:CardExpander>

        <ui:Button
            x:Name="DefaultsButton"
            Margin="0,16,0,0"
            Content="Restore the default list"
            Icon="{ui:SymbolIcon ArrowReset24}" />
    </StackPanel>
</Page>
