<ui:FluentWindow
    x:Class="WormsCursor.App.ControlPanel.ControlPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WormsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="WormsCursor"
    Width="1040"
    Height="720"
    MinWidth="760"
    MinHeight="540"
    ExtendsContentIntoTitleBar="True"
    FontFamily="Segoe UI Variable Text, Segoe UI"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    UseLayoutRounding="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen">

    <ui:FluentWindow.Resources>
        <!--  The status dot for agents that are done: the theme's informational blue (Windows has no
              ready-made brush for it), distinct from the caution yellow of "needs you".  -->
        <SolidColorBrush x:Key="StatusDoneBrush" Color="{DynamicResource SystemFillColorAttention}" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            FrameMargin="0"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleVisible="False"
            OpenPaneLength="280"
            PaneDisplayMode="Left"
            TitleBar="{Binding ElementName=TitleBar, Mode=OneWay}"
            Transition="FadeInWithSlide">

            <!--  At a glance: what the token is doing. The title bar already names the app. In the
                  icon-only sidebar just the dot shows, with the words in its tooltip.  -->
            <ui:NavigationView.PaneHeader>
                <Grid
                    x:Name="StatusPanel"
                    Height="36"
                    Margin="0,0,0,8"
                    Background="Transparent">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Ellipse
                        x:Name="StatusDot"
                        Width="10"
                        Height="10"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                    <ui:TextBlock
                        x:Name="StatusText"
                        Grid.Column="1"
                        Margin="2,0,12,1"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap" />
                </Grid>
            </ui:NavigationView.PaneHeader>

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem
                    x:Name="TokenItem"
                    Content="Token"
                    Icon="{ui:SymbolIcon CursorHover24}"
                    TargetPageType="{x:Type local:TokenPage}" />
                <ui:NavigationViewItem
                    Content="Agents"
                    Icon="{ui:SymbolIcon Bot24}"
                    TargetPageType="{x:Type local:AgentsPage}" />
                <ui:NavigationViewItem
                    Content="Apps"
                    Icon="{ui:SymbolIcon EyeOff24}"
                    TargetPageType="{x:Type local:AppsPage}" />
            </ui:NavigationView.MenuItems>
            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem
                    Content="About"
                    Icon="{ui:SymbolIcon Info24}"
                    TargetPageType="{x:Type local:AboutPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <ui:TitleBar
            x:Name="TitleBar"
            Title="WormsCursor"
            Grid.Row="0"
            ShowMaximize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon x:Name="TitleIcon" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>
    </Grid>
</ui:FluentWindow>
