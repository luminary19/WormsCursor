<Page
    x:Class="WormsCursor.App.ControlPanel.TokenPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WormsCursor.App.ControlPanel"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Token">

    <Page.Resources>
        <ResourceDictionary Source="/WormsCursor;component/ControlPanel/PanelStyles.xaml" />
    </Page.Resources>

    <StackPanel Margin="40,28,40,40">
        <ui:TextBlock Style="{StaticResource PageTitle}" Text="Token" />
        <ui:TextBlock Style="{StaticResource PageLead}" Text="The token bounces on screen when an AI agent needs you, and goes away once you're back." />

        <ui:CardControl Margin="0,16,0,4" Icon="{ui:SymbolIcon Power24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Show the token" Description="When it's off, agents are still tracked but nothing appears." />
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="EnabledSwitch" AutomationProperties.Name="Show the token" />
        </ui:CardControl>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Preview" />
        <Border Padding="16,16,16,12" Style="{StaticResource Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Each swatch is half dark, half light, with the token across the seam,
                      so one glance shows how it reads on both.  -->
                <Grid Grid.Column="0" AutomationProperties.Name="Preview: agent is done">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#202020" CornerRadius="6,0,0,6" />
                    <Border
                        Grid.Column="1"
                        Background="#F3F3F3"
                        CornerRadius="0,6,6,0" />
                    <Border
                        Grid.ColumnSpan="2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6" />
                    <local:TokenPreview x:Name="DonePreview" Grid.ColumnSpan="2" />
                </Grid>
                <Grid Grid.Column="2" AutomationProperties.Name="Preview: agent needs you">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="#202020" CornerRadius="6,0,0,6" />
                    <Border
                        Grid.Column="1"
                        Background="#F3F3F3"
                        CornerRadius="0,6,6,0" />
                    <Border
                        Grid.ColumnSpan="2"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6" />
                    <local:TokenPreview
                        x:Name="BlockedPreview"
                        Grid.ColumnSpan="2"
                        Blocked="True" />
                </Grid>

                <StackPanel Grid.Row="1" Margin="2,12,0,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Done" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Style="{StaticResource Secondary}"
                        Text="The agent finished its turn." />
                </StackPanel>
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="2,12,0,0">
                    <ui:TextBlock FontTypography="BodyStrong" Text="Needs you" />
                    <ui:TextBlock
                        FontTypography="Caption"
                        Style="{StaticResource Secondary}"
                        Text="The agent is waiting for your answer." />
                </StackPanel>
            </Grid>
        </Border>

        <ui:TextBlock Style="{StaticResource SectionHeader}" Text="Size and position" />
        <ui:CardControl Icon="{ui:SymbolIcon ResizeLarge24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Size" Description="How big the token is on screen." />
            </ui:CardControl.Header>
            <StackPanel Orientation="Horizontal">
                <ui:TextBlock
                    x:Name="SizeText"
                    MinWidth="52"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Secondary}"
                    TextAlignment="Right" />
                <Slider
                    x:Name="SizeSlider"
                    Width="220"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Token size"
                    IsSnapToTickEnabled="True"
                    LargeChange="24"
                    SmallChange="8"
                    TickFrequency="8" />
            </StackPanel>
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon CursorHover24}">
            <ui:CardControl.Header>
                <local:SettingHeader Title="Position" Description="Follow the pointer, or wait in a corner of your main screen." />
            </ui:CardControl.Header>
            <ComboBox
                x:Name="PlacementBox"
                MinWidth="200"
                AutomationProperties.Name="Position">
                <ComboBoxItem Content="Follow the pointer" />
                <ComboBoxItem Content="Screen corner" />
            </ComboBox>
        </ui:CardControl>
        <ui:CardControl x:Name="CornerCard" Icon="{ui:SymbolIcon Desktop24}">
            <ui:CardControl.Header>
                <local:SettingHeader x:Name="CornerHeader" Title="Corner" />
            </ui:CardControl.Header>
            <ComboBox
                x:Name="CornerBox"
                MinWidth="200"
                AutomationProperties.Name="Corner">
                <ComboBoxItem Content="Top left" />
                <ComboBoxItem Content="Top right" />
                <ComboBoxItem Content="Bottom left" />
                <ComboBoxItem Content="Bottom right" />
            </ComboBox>
        </ui:CardControl>

        <ui:Button
            x:Name="ResetButton"
            Margin="0,16,0,0"
            Content="Reset size and position"
            Icon="{ui:SymbolIcon ArrowReset24}" />
    </StackPanel>
</Page>
