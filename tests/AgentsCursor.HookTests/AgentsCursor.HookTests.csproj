  <ItemGroup>
    <Compile Include="../../src/AgentsCursor.App/AgentHookBridge.cs" Link="AgentHookBridge.cs" />
    <Compile Include="../../src/AgentsCursor.App/AgentPipeServer.cs" Link="AgentPipeServer.cs" />
    <Compile Include="../../src/AgentsCursor.App/AppLog.cs" Link="AppLog.cs" />
    <Compile Include="../../src/AgentsCursor.App/Autostart.cs" Link="Autostart.cs" />
    <Compile Include="../../src/AgentsCursor.App/ControlPanel/ReleaseNotesFormat.cs" Link="ReleaseNotesFormat.cs" />
    <Compile Include="../../src/AgentsCursor.App/Services/AgentHookRegistrar.cs" Link="AgentHookRegistrar.cs" />
    <Compile Include="../../src/AgentsCursor.App/Services/HooksJson.cs" Link="HooksJson.cs" />
    <Compile Include="../../src/AgentsCursor.App/Services/JsoncEdit.cs" Link="JsoncEdit.cs" />
    <Compile Include="../../src/AgentsCursor.App/Services/OpenCodePlugins.cs" Link="OpenCodePlugins.cs" />
    <Compile Include="../../src/AgentsCursor.App/Services/PiExtensions.cs" Link="PiExtensions.cs" />
  </ItemGroup>
  <!-- The plugins next to the test exe, as next to AgentsCursor.exe, for the registrar tests. -->
  <Import Project="../../integrations/Integrations.props" />
</Project>
